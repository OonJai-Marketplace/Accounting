/** Direct journal importer. No posting or database mutation. */
var DB_URL='https://nhjsesfhapnjtwlxvirm.supabase.co';
var DB_KEY='sb_publishable_Yyl2REESOnJwZaU2_vdahw_JiOIVlUx';
function onOpen(){SpreadsheetApp.getUi().createMenu('Accounting').addItem('Import from database','openImportHome').addItem('Sign out of database','signOutDatabase').addToUi();}
function openImportHome(){SpreadsheetApp.getUi().showSidebar(HtmlService.createHtmlOutputFromFile('Import').setTitle('Import from database'));}
function request_(path,body,token){var r=UrlFetchApp.fetch(DB_URL+path,{method:'post',contentType:'application/json',headers:{apikey:DB_KEY,Authorization:'Bearer '+(token||DB_KEY)},payload:JSON.stringify(body),muteHttpExceptions:true});if(r.getResponseCode()<200||r.getResponseCode()>=300){var msg='';try{msg=JSON.parse(r.getContentText()).message||'';}catch(e){}throw Error('Database request failed ('+r.getResponseCode()+'). '+msg);}return JSON.parse(r.getContentText());}
function saveSession_(s){PropertiesService.getUserProperties().setProperty('DIRECT_DB_SESSION',JSON.stringify({access_token:s.access_token,refresh_token:s.refresh_token,expires_at:s.expires_at||Math.floor(Date.now()/1000)+s.expires_in}));}
function session_(){var s=JSON.parse(PropertiesService.getUserProperties().getProperty('DIRECT_DB_SESSION')||'null');if(!s)throw Error('Sign in with your accounting administrator account.');if(!s.expires_at||s.expires_at*1000<Date.now()+60000){s=request_('/auth/v1/token?grant_type=refresh_token',{refresh_token:s.refresh_token});saveSession_(s);}return s.access_token;}
function signInDatabase(email,password){var s=request_('/auth/v1/token?grant_type=password',{email:String(email).trim(),password:password});request_('/rest/v1/rpc/sheets_journal_import_v2',{p_from:'1900-01-01',p_to:'1900-01-01'},s.access_token);saveSession_(s);return 'Signed in. Choose a period and import.';}
function signOutDatabase(){PropertiesService.getUserProperties().deleteProperty('DIRECT_DB_SESSION');return 'Signed out of this importer.';}
function validDate_(v){if(typeof v!=='string'||!/^\d{4}-\d{2}-\d{2}$/.test(v)||!isFinite(Date.parse(v+'T00:00:00Z'))||new Date(v+'T00:00:00Z').toISOString().slice(0,10)!==v)throw Error('Enter a valid date.');return v;}
function periodBounds_(mode,year,part,from,to){year=Number(year);part=Number(part);if(mode==='Custom'){from=validDate_(from);to=validDate_(to);}else{if(!Number.isInteger(year)||year<1900||year>2200)throw Error('Choose a valid year.');var m,n;if(mode==='Year'){m=0;n=12;}else if(mode==='Quarter'&&Number.isInteger(part)&&part>=1&&part<=4){m=(part-1)*3;n=3;}else if(mode==='Month'&&Number.isInteger(part)&&part>=1&&part<=12){m=part-1;n=1;}else throw Error('Choose Year, Quarter, Month, or Custom.');from=new Date(Date.UTC(year,m,1)).toISOString().slice(0,10);to=new Date(Date.UTC(year,m+n,0)).toISOString().slice(0,10);}if(from>to)throw Error('Start date is after end date.');return {from:from,to:to};}
function md5_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.MD5,s,Utilities.Charset.UTF_8).map(function(b){return ('0'+(b&255).toString(16)).slice(-2);}).join('');}
function serial_(v){return (Date.parse(validDate_(v)+'T00:00:00Z')-Date.UTC(1899,11,30))/86400000;}
function validatePack_(p,period,hash){if(p.version!==2||p.from!==period.from||p.to!==period.to||hash(p.rowsJson)!==p.hash)throw Error('Snapshot identity or checksum mismatch.');var rows=JSON.parse(p.rowsJson),seen={},entries={},selected=[],prior=0;if(!Array.isArray(rows)||rows.length>10000)throw Error('Journal capacity exceeded.');rows.forEach(function(r){if(!Array.isArray(r)||r.length!==16||!r[13]||!r[14]||!r[4]||r[2]!=='posted'||!r[8]||!r[6])throw Error('Incomplete journal line.');validDate_(r[0]);if(r[0]>period.to||seen[r[13]])throw Error('Duplicate or out-of-range line.');seen[r[13]]=true;if(typeof r[9]!=='number'||!isFinite(r[9])||typeof r[10]!=='number'||!isFinite(r[10]))throw Error('Invalid journal amount.');if(r[0]>=period.from){selected.push(r);entries[r[14]]=true;}else prior++;});var c=p.receipt;if(!c||c.lines!==selected.length||c.entries!==Object.keys(entries).length||c.priorLines!==prior||c.totalLines!==rows.length)throw Error('Source and received counts differ.');if((selected[0]?.[1]||null)!==c.firstId||(selected[selected.length-1]?.[1]||null)!==c.lastId||(selected[0]?.[0]||null)!==c.firstDate||(selected[selected.length-1]?.[0]||null)!==c.lastDate)throw Error('Receipt date or entry ID mismatch.');if(!Array.isArray(p.accounts)||p.accounts.length>5000||!Array.isArray(p.entryList)||p.entryList.length!==c.entries)throw Error('Invalid supporting records.');return rows;}
function stateForImport(){var h=SpreadsheetApp.getActive().getSheetByName('Home');return {mode:h.getRange('B26').getValue(),year:h.getRange('B27').getValue(),part:h.getRange('B28').getValue(),from:h.getRange('B29').getDisplayValue(),to:h.getRange('B30').getDisplayValue(),connected:!!PropertiesService.getUserProperties().getProperty('DIRECT_DB_SESSION')};}
function importFromDatabase(mode,year,part,from,to){var period=periodBounds_(mode,year,part,from,to),lock=LockService.getDocumentLock();if(!lock.tryLock(1000))throw Error('An import is already running.');var ss=SpreadsheetApp.getActive(),stage,published=false;try{
 if(!ss.getSheetByName('Journal data'))throw Error('Use the Accounting — Import and Review workbook.');
 var p=request_('/rest/v1/rpc/sheets_journal_import_v2',{p_from:period.from,p_to:period.to},session_()),journal=validatePack_(p,period,md5_);
 var all=[['Dataset','Source row','Field 01','Field 02','Field 03','Field 04','Field 05','Field 06','Field 07','Field 08','Field 09','Field 10','Field 11','Field 12','Field 13','Field 14','Field 15','Field 16']];
 function add(name,i,cells){var r=[name,i].concat(cells.map(function(v){return v===null?'':v;}));if(r.length>18)throw Error('Too many fields.');while(r.length<18)r.push('');all.push(r);}
 journal.forEach(function(r,i){r=r.slice();r[0]=serial_(r[0]);add('Journal',i+1,r);});p.accounts.forEach(function(r,i){if(r.length!==8)throw Error('Invalid account row.');add('Chart of Accounts',i+1,r);});
 // Preserve unrelated imported modules, explicitly marked as not refreshed by this journal import.
 var old=ss.getRangeByName('RawImport');if(old)old.getValues().slice(1).forEach(function(r){if(r[0]&&['Journal','Chart of Accounts','Metadata','Import Receipt','Import Entries'].indexOf(r[0])<0)all.push(r.slice(0,18));});
 var c=p.receipt;add('Metadata',1,[p.createdAt,period.from,period.to,journal.length,'Direct database · posted journal']);
 add('Import Receipt',1,[p.createdAt,period.from,period.to,c.lines,c.entries,c.firstId,c.lastId,c.firstDate,c.lastDate,c.priorLines,c.totalLines,p.hash]);
 p.entryList.forEach(function(r,i){add('Import Entries',i+1,r);});if(all.length>50003)throw Error('Raw-data capacity exceeded.');
 stage=ss.insertSheet('_Incoming_'+Date.now());if(stage.getMaxRows()<all.length)stage.insertRowsAfter(stage.getMaxRows(),all.length-stage.getMaxRows());
 // RAW Sheets API writes preserve text, including leading = and apostrophes, without formula execution.
 for(var i=0;i<all.length;i+=500){var b=all.slice(i,i+500),range="'"+stage.getName()+"'!A"+(i+1)+':R'+(i+b.length);sheetsRequest_('/values/'+encodeURIComponent(range)+'?valueInputOption=RAW','put',{range:range,majorDimension:'ROWS',values:b});}
 SpreadsheetApp.flush();if(JSON.stringify(stage.getRange(1,1,all.length,18).getValues())!==JSON.stringify(all))throw Error('Raw-data readback mismatch; previous snapshot retained.');
 ss.setNamedRange('RawImport',stage.getRange(1,1,all.length,18));published=true;
 try{if(old){old.getSheet().setName('_Previous_'+Date.now());old.getSheet().hideSheet();}stage.setName('Raw Data');stage.setFrozenRows(1);stage.getRange(1,1,1,18).setFontWeight('bold').setBackground('#d9ead3');}catch(layoutError){}
 SpreadsheetApp.flush();var cleanup=cleanupImportSnapshots_(ss,stage,old&&old.getSheet());return {message:'Import complete: '+c.lines+' journal lines / '+c.entries+' entries in '+period.from+' to '+period.to+'. First ID: '+(c.firstId||'none')+'; last ID: '+(c.lastId||'none')+'. '+c.priorLines+' earlier lines retained for opening balances. See Import Receipt.'+(cleanup?' Cleanup pending: '+cleanup:''),receipt:c};
 }catch(e){if(!published&&stage){try{ss.deleteSheet(stage);}catch(cleanupError){}}throw Error((published?'Snapshot published; inspect Import Receipt. ':'Import not published; previous snapshot remains active. ')+e.message);}finally{lock.releaseLock();}}
function sheetsRequest_(path,method,body){var r=UrlFetchApp.fetch('https://sheets.googleapis.com/v4/spreadsheets/'+SpreadsheetApp.getActive().getId()+path,{method:method,contentType:'application/json',headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},payload:JSON.stringify(body),muteHttpExceptions:true});if(r.getResponseCode()!==200)throw Error('Google Sheets staging failed ('+r.getResponseCode()+').');return JSON.parse(r.getContentText());}

// Keep the current verified snapshot and its immediate predecessor. Never touch
// named-range targets, visible worksheets, or sheets outside importer ownership.
function cleanupImportSnapshots_(ss,current,previous){
 var protectedIds={};protectedIds[current.getSheetId()]=true;if(previous)protectedIds[previous.getSheetId()]=true;
 ss.getNamedRanges().forEach(function(n){protectedIds[n.getRange().getSheet().getSheetId()]=true;});
 var failures=[];ss.getSheets().forEach(function(sheet){
  if(protectedIds[sheet.getSheetId()]||!sheet.isSheetHidden()||!/^_Previous_[0-9]+$/.test(sheet.getName()))return;
  try{ss.deleteSheet(sheet);}catch(e){failures.push(sheet.getName());}
 });return failures.join(', ');
}
