{
  "name": "pocket-document-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test test/*.test.mjs",
    "native:android": "npm run build && cap add android && node tools/configure.mjs android && cap sync android",
    "native:ios": "npm run build && cap add ios && node tools/configure.mjs ios && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/camera": "8.2.6",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2"
  }
}
